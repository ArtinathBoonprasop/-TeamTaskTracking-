<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Team Task Tracking</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="projects">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Projects
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tasks">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Tasks
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 text-white-50 small py-2">@context.User.Identity?.Name</div>
                <div class="nav-item px-3">
                    <form method="post" action="/account/logout">
                        <AntiforgeryToken />
                        <button class="nav-link border-0 bg-transparent" type="submit">ออกจากระบบ</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3"><NavLink class="nav-link" href="login">เข้าสู่ระบบ</NavLink></div>
                <div class="nav-item px-3"><NavLink class="nav-link" href="register">สมัครสมาชิก</NavLink></div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

