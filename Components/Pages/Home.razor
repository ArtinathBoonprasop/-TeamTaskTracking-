@page "/"
@attribute [Authorize]
@inject AppDbContext Db

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>
<p class="text-muted">ภาพรวมงานของทีม</p>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3"><div class="card text-bg-primary h-100"><div class="card-body"><div>โครงการทั้งหมด</div><div class="display-6">@ProjectCount</div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card text-bg-secondary h-100"><div class="card-body"><div>งานทั้งหมด</div><div class="display-6">@TaskCount</div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card text-bg-warning h-100"><div class="card-body"><div>กำลังรอทำ</div><div class="display-6">@PendingCount</div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card text-bg-success h-100"><div class="card-body"><div>เสร็จสิ้น</div><div class="display-6">@CompletedCount</div></div></div></div>
</div>

<div class="card shadow-sm">
    <div class="card-header">โครงการล่าสุด</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>ชื่อโครงการ</th><th>สถานะ</th><th>วันเริ่ม</th><th>วันสิ้นสุด</th></tr></thead>
            <tbody>
                @if (LatestProjects.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">ยังไม่มีโครงการ</td></tr>
                }
                else
                {
                    @foreach (var project in LatestProjects)
                    {
                        <tr><td>@project.ProjectName</td><td>@(project.Status ?? "-")</td><td>@project.StartDate?.ToString("dd/MM/yyyy")</td><td>@project.EndDate?.ToString("dd/MM/yyyy")</td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private int ProjectCount;
    private int TaskCount;
    private int PendingCount;
    private int CompletedCount;
    private List<Project> LatestProjects = [];

    protected override async Task OnInitializedAsync()
    {
        ProjectCount = await Db.Projects.CountAsync();
        TaskCount = await Db.Tasks.CountAsync();
        PendingCount = await Db.Tasks.CountAsync(task => task.Status == "Pending");
        CompletedCount = await Db.Tasks.CountAsync(task => task.Status == "Completed");
        LatestProjects = await Db.Projects.OrderByDescending(project => project.ProjectID).Take(5).ToListAsync();
    }
}
